  <header>
      <nav class="bg-gray-100 px-6 py-2">
        <div class="flex items-center">

          <a href="/" class="mr-6 text-lg font-semibold text-gray-800">
            Shopping Cart
          </a>

          <a href="/" class="mr-5 text-sm text-gray-800">
            Products 
          </a>

          <a
            href="/cart"
            class="mr-5 text-sm text-gray-600 hover:text-gray-900"
          >
