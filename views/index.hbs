<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Hello World</title>

    <!-- Tailwind CSS -->
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>

  <body>

    <header>
      <nav class="bg-gray-100 px-6 py-2">
        <div class="flex items-center">

          <a href="/" class="mr-6 text-lg font-semibold text-gray-800">
            Shopping Cart
          </a>

          <a href="/" class="mr-5 text-sm text-gray-800">
            Home
          </a>

          <a
            href="/link"
            class="mr-5 text-sm text-gray-600 hover:text-gray-900"
          >
            Link
          </a>

          <span class="text-sm text-gray-400">
            Disabled
          </span>

          <form class="ml-auto flex" action="/search" method="GET">
            <input
              type="text"
              name="q"
              placeholder="Search"
              class="w-28 border border-gray-300 px-2 py-1 text-sm"
            />

            <button
              type="submit"
              class="ml-1 border border-green-500 px-3 py-1 text-sm text-green-600 hover:bg-green-500 hover:text-white"
            >
              Search
            </button>
          </form>

        </div>
      </nav>
    </header>

    <section>
      <div class=" mt-16 px-6">
        <div class="grid grid-cols-3 gap-6 pl-30">
          {{#each products}}
          <div class="w-72 overflow-hidden rounded-lg bg-white shadow-md">

            <!-- Product Image -->
            <img
              src = "{{this.image}}"
              alt="Product"
              class="h-32 w-full object-cover"
            />

            <!-- Card Content -->
            <div class="p-3">

              <h2 class="my-1 text-lg font-semibold text-gray-800">
                {{this.name}}                  </h2>

              <p class="mb-2 text-sm text-gray-500">
                {{this.description}}
              </p>

              <div class="mb-4 flex items-center justify-between">
                <span class="text-xl font-bold text-gray-800">
                  ${{this.price}}
                </span>

                <span class="text-sm text-green-600">
                  In Stock
                </span>
              </div>

              <button
                class="w-full rounded-md bg-blue-600 px-4 py-2 text-white hover:bg-blue-700">
                Add to Cart
              </button>

            </div>
          </div>
          {{/each}}
        </div>
      </div>
    </section>

  </body>
</html>