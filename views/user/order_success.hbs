<section class="min-h-[70vh] flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-lg bg-white rounded-2xl shadow-xl border border-gray-100 p-8 text-center">

        <div class="mx-auto w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mb-6">
            <svg class="w-10 h-10 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                    d="M5 13l4 4L19 7">
                </path>
            </svg>
        </div>

        <h1 class="text-3xl font-bold text-gray-900">
            Order Placed Successfully!
        </h1>

        <p class="text-gray-500 mt-3 leading-relaxed">
            Thank you for shopping with us. Your order has been successfully placed.
            We will notify you once your order is processed.
        </p>

        {{#if orderId}}
        <div class="mt-6 bg-gray-50 rounded-lg p-4">
            <p class="text-sm text-gray-500">Order ID</p>
            <p class="font-semibold text-gray-800 mt-1">{{orderId}}</p>
        </div>
        {{/if}}

        <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">

            <a href="/orders"
                class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-semibold transition">
                View Orders
            </a>

            <a href="/"
                class="border border-gray-300 hover:bg-gray-50 text-gray-700 px-6 py-3 rounded-lg font-semibold transition">
                Continue Shopping
            </a>

        </div>

    </div>
</section>