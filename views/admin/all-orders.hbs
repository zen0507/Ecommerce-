<div class="min-h-screen bg-gray-50 px-4 py-8 sm:px-6">

  <div class="mx-auto max-w-7xl">

    <!-- Page Header -->
    <div class="mb-7">
      <h1 class="text-2xl font-bold text-gray-800">
        All Orders
      </h1>
      <p class="mt-2 text-sm text-gray-500">
        Manage and monitor customer orders.
      </p>
    </div>

    <!-- Summary Card -->
    <div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2">

      <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-medium text-gray-500">Total Orders</p>
        <h2 class="mt-2 text-2xl font-bold text-gray-800">
          {{orders.length}}
        </h2>
      </div>

      <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-medium text-gray-500">Order Management</p>
        <h2 class="mt-2 text-lg font-semibold text-blue-600">
          All Customer Orders
        </h2>
      </div>

    </div>

    <!-- Orders Table -->
    <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">

      <div class="border-b border-gray-200 px-6 py-5">
        <h2 class="text-base font-semibold text-gray-800">
          Recent Orders
        </h2>
        <p class="mt-1 text-sm text-gray-500">
          View order summaries and access complete order details.
        </p>
      </div>

      <div class="overflow-x-auto">

        <table class="admin-data-table w-full text-left text-sm">

          <!-- Table Header -->
          <thead class="bg-gray-100">
            <tr class="border-b border-gray-200">

              <th class="px-5 py-4 font-semibold text-gray-700">No.</th>

              <th class="px-5 py-4 font-semibold text-gray-700">Order ID</th>

              <th class="px-5 py-4 font-semibold text-gray-700">Customer</th>

              <th class="px-5 py-4 font-semibold text-gray-700">Products</th>

              <th class="px-5 py-4 font-semibold text-gray-700">Amount</th>

              <th class="px-5 py-4 font-semibold text-gray-700">Payment</th>

              <th class="px-5 py-4 font-semibold text-gray-700">Status</th>

              <th class="px-5 py-4 font-semibold text-gray-700">Order Date</th>

              <th class="px-5 py-4 text-center font-semibold text-gray-700">Action</th>

            </tr>
          </thead>

          <!-- Table Body -->
          <tbody class="divide-y divide-gray-100">

            {{#each orders}}

              <tr class="transition hover:bg-gray-50">

                <!-- Automatic Number -->
                <td class="whitespace-nowrap px-5 py-4 text-gray-500">
                  {{addOne @index}}
                </td>

                <!-- Order ID -->
                <td class="whitespace-nowrap px-5 py-4">
                  <span class="font-medium text-gray-700">
                    #{{this._id}}
                  </span>
                </td>

                <!-- Customer Name -->
                <td class="whitespace-nowrap px-5 py-4">
                  <span class="font-semibold text-gray-800">
                    {{#if this.userDetails}}
                      {{this.userDetails.name}}
                    {{else}}
                      Unknown Customer
                    {{/if}}
                  </span>
                </td>

                <!-- Product Count -->
                <td class="whitespace-nowrap px-5 py-4 text-gray-600">
                  {{this.productDetails.length}} items
                </td>

                <!-- Amount -->
                <td class="whitespace-nowrap px-5 py-4 font-semibold text-gray-800">
                  ₹{{this.totalAmount}}
                </td>

                <!-- Payment -->
                <td class="whitespace-nowrap px-5 py-4">

                  {{#if (eq this.paymentMethod "Online")}}
                    <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700">
                      Online
                    </span>
                  {{else}}
                    <span class="rounded-full bg-orange-50 px-3 py-1 text-xs font-semibold text-orange-700">
                      COD
                    </span>
                  {{/if}}

                </td>

                <!-- Status -->
                <td class="whitespace-nowrap px-5 py-4">

                  {{#if (eq this.status "placed")}}
                    <span class="rounded-full bg-green-50 px-3 py-1 text-xs font-semibold text-green-700">
                      Placed
                    </span>

                  {{else if (eq this.status "shipped")}}
                    <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700">
                      Shipped
                    </span>

                  {{else if (eq this.status "delivered")}}
                    <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">
                      Delivered
                    </span>

                  {{else if (eq this.status "cancelled")}}
                    <span class="rounded-full bg-red-50 px-3 py-1 text-xs font-semibold text-red-700">
                      Cancelled
                    </span>

                  {{else}}
                    <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-600">
                      {{this.status}}
                    </span>
                  {{/if}}

                </td>

                <!-- Date -->
                <td class="whitespace-nowrap px-5 py-4 text-xs text-gray-500">
                  {{this.date}}
                </td>

                <!-- View Details Button -->
                <td class="whitespace-nowrap px-5 py-4 text-center">

                  <button
                    type="button"
                    onclick="document.getElementById('order-{{this._id}}').showModal()"
                    class="rounded-lg bg-blue-600 px-4 py-2 text-xs font-semibold text-white transition hover:bg-blue-700"
                  >
                    View Details
                  </button>

                </td>

              </tr>

              <!-- Order Details Modal -->
              <dialog
                id="order-{{this._id}}"
                class="m-auto max-h-[90vh] w-[95%] max-w-3xl overflow-y-auto rounded-xl bg-white p-0 shadow-2xl backdrop:bg-black/50"
              >

                <!-- Modal Header -->
                <div class="sticky top-0 z-10 flex items-center justify-between border-b border-gray-200 bg-white px-6 py-5">

                  <div>
                    <h2 class="text-lg font-bold text-gray-800">
                      Order Details
                    </h2>

                    <p class="mt-1 text-xs text-gray-500">
                      Order ID: {{this._id}}
                    </p>
                  </div>

                  <button
                    type="button"
                    onclick="document.getElementById('order-{{this._id}}').close()"
                    class="rounded-lg p-2 text-gray-500 transition hover:bg-gray-100 hover:text-gray-800"
                    aria-label="Close modal"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                  </button>

                </div>

                <div class="space-y-6 p-6">

                  <!-- Customer Information -->
                  <section>

                    <h3 class="mb-3 text-sm font-bold text-gray-800">
                      Customer Information
                    </h3>

                    <div class="grid grid-cols-1 gap-4 rounded-lg bg-gray-50 p-4 sm:grid-cols-2">

                      <div>
                        <p class="text-xs text-gray-500">Customer Name</p>
                        <p class="mt-1 font-semibold text-gray-800">
                          {{this.userDetails.name}}
                        </p>
                      </div>

                      <div>
                        <p class="text-xs text-gray-500">Customer ID</p>
                        <p class="mt-1 break-all text-sm text-gray-700">
                          {{this.userId}}
                        </p>
                      </div>

                      <div>
                        <p class="text-xs text-gray-500">Mobile Number</p>
                        <p class="mt-1 font-medium text-gray-800">
                          {{this.deliveryDetails.mobile}}
                        </p>
                      </div>

                      <div>
                        <p class="text-xs text-gray-500">Pincode</p>
                        <p class="mt-1 font-medium text-gray-800">
                          {{this.deliveryDetails.pincode}}
                        </p>
                      </div>

                      <div class="sm:col-span-2">
                        <p class="text-xs text-gray-500">Delivery Address</p>
                        <p class="mt-1 font-medium text-gray-800">
                          {{this.deliveryDetails.address}}
                        </p>
                      </div>

                    </div>

                  </section>

                  <!-- Products Information -->
                  <section>

                    <h3 class="mb-3 text-sm font-bold text-gray-800">
                      Ordered Products
                    </h3>

                    <div class="space-y-3">

                      {{#each this.productDetails}}

                        <div class="flex flex-col gap-4 rounded-lg border border-gray-200 p-4 sm:flex-row sm:items-center">

                          <!-- Product Image -->
                          {{#if this.name}}
                            <img
                              src="/product-images/{{this._id}}.jpg"
                              alt="{{this.name}}"
                              class="h-20 w-20 rounded-lg border border-gray-200 object-cover"
                            />
                          {{else}}
                            <div class="flex h-20 w-20 items-center justify-center rounded-lg bg-gray-100 text-xs text-gray-400">
                              No Image
                            </div>
                          {{/if}}

                          <!-- Product Details -->
                          <div class="min-w-0 flex-1">

                            <p class="font-semibold text-gray-800">
                              {{#if this.name}}
                                {{this.name}}
                              {{else}}
                                Product unavailable
                              {{/if}}
                            </p>

                            <p class="mt-1 break-all text-xs text-gray-500">
                              Product ID: {{this._id}}
                            </p>

                            <p class="mt-2 text-sm font-medium text-gray-600">
                              Quantity: {{this.quantity}}
                            </p>

                          </div>

                          <!-- Product Price -->
                          {{#if this.name}}
                            <div class="text-sm font-semibold text-gray-800">
                              ₹{{this.price}}
                            </div>
                          {{/if}}

                        </div>

                      {{/each}}

                    </div>

                  </section>

                  <!-- Payment Information -->
                  <section>

                    <h3 class="mb-3 text-sm font-bold text-gray-800">
                      Payment Information
                    </h3>

                    <div class="grid grid-cols-1 gap-4 rounded-lg bg-gray-50 p-4 sm:grid-cols-2">

                      <div>
                        <p class="text-xs text-gray-500">Payment Method</p>
                        <p class="mt-1 font-semibold text-gray-800">
                          {{this.paymentMethod}}
                        </p>
                      </div>

                      <div>
                        <p class="text-xs text-gray-500">Payment Status / Order Status</p>
                        <p class="mt-1 font-semibold text-gray-800">
                          {{this.status}}
                        </p>
                      </div>

                      {{#if this.paymentId}}
                        <div>
                          <p class="text-xs text-gray-500">Razorpay Payment ID</p>
                          <p class="mt-1 break-all text-xs text-gray-700">
                            {{this.paymentId}}
                          </p>
                        </div>
                      {{/if}}

                      {{#if this.razorpayOrderId}}
                        <div>
                          <p class="text-xs text-gray-500">Razorpay Order ID</p>
                          <p class="mt-1 break-all text-xs text-gray-700">
                            {{this.razorpayOrderId}}
                          </p>
                        </div>
                      {{/if}}

                    </div>

                  </section>

                  <!-- Total -->
                  <div class="flex items-center justify-between rounded-lg bg-blue-50 p-4">

                    <span class="font-semibold text-gray-700">
                      Total Order Amount
                    </span>

                    <span class="text-xl font-bold text-blue-700">
                      ₹{{this.totalAmount}}
                    </span>

                  </div>

                </div>

                <!-- Modal Footer -->
                <div class="border-t border-gray-200 px-6 py-4 text-right">

                  <button
                    type="button"
                    onclick="document.getElementById('order-{{this._id}}').close()"
                    class="rounded-lg border border-gray-300 px-5 py-2 text-sm font-semibold text-gray-700 transition hover:bg-gray-100"
                  >
                    Close
                  </button>

                </div>

              </dialog>

            {{/each}}

          </tbody>

        </table>

      </div>

    </div>

  </div>

</div>

<!-- Close modal when clicking outside -->
<script>
  document.querySelectorAll("dialog").forEach((dialog) => {
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) {
        dialog.close();
      }
    });
  });
</script>
